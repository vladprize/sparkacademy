        { q: "360-сфера отвечает на вопрос:", options: ["что вокруг объекта", "какая цена", "какие сроки"], correct: 0, why: "Виды и инфраструктура вокруг." },
        { q: "Главный инструмент рекламы:", options: ["3D source video 15–60 сек", "2D-план", "договор"], correct: 0, why: "Эмоциональное видео = shareable контент." },
        { q: "3D-планировки хороши для:", options: ["семейных покупателей", "только офисов", "стройки"], correct: 0, why: "Рациональный аргумент про удобство." },
        { q: "3D-модуль продаж включает:", options: ["customer journey + CRM + обучалки агентов", "только фото", "калькулятор"], correct: 0, why: "Полный инструмент продаж (QubeHub)." },
        { q: "Партнёрские услуги — это про:", options: ["апсейл и единое окно", "снижение чека", "стройку"], correct: 0, why: "Дизайн, маркетинг, сайты, лидген, SaaS." },
        { q: "Партнёрку предлагают:", options: ["когда принята ценность визуала", "в первую же минуту", "никогда"], correct: 0, why: "Сначала база, потом расширение." },
