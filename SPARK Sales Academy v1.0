        { q: "На запуске девелопер продаёт:", options: ["готовые квартиры", "идею и мечту (off-plan)", "стройматериалы"], correct: 1, why: "Здание ещё не построено." },
        { q: "Визуал на запуске:", options: ["украшение", "сам товар для продажи идеи", "лишний расход"], correct: 1, why: "Без него нечем продавать." },
        { q: "Зачем быстрый старт?", options: ["показать спрос инвесторам и держать кэшфлоу", "отдохнуть", "поднять цену на стройматериалы"], correct: 0, why: "Финансирование + деньги на стройку." },
        { q: "Деньги первых покупателей:", options: ["идут в стройку", "не используются", "возвращаются"], correct: 0, why: "Кэшфлоу питает проект." },
        { q: "Что происходит в хаосе запуска?", options: ["горят сроки, растут бюджеты, меняется проект", "тишина", "всё готово"], correct: 0, why: "Максимальный стресс девелопера." },
        { q: "3 задачи девелопера к запуску:", options: ["выбрать визуал, собрать маркетинг-материалы, единый пакет", "уволить всех", "остановить проект"], correct: 0, why: "Именно сюда заходит SPARK." },
        { q: "Менеджер SPARK на запуске продаёт:", options: ["снятие боли и готовый визуальный пакет", "просто рендер", "скидку"], correct: 0, why: "Порядок в хаос дороже картинки." },
