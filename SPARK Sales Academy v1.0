const ACADEMY = [
  {
    id: "m1", title: "Рынок и девелоперы", full: "Кто главный на рынке недвижимости и как он мыслит",
    lessons: [
      {
        id: "l1", title: "Кто такой девелопер", src: "Лекция 1",
        body: "Девелопер — главный стратег, менеджер и драйвер проекта в недвижимости. Именно он инициирует, планирует, финансирует и руководит созданием проекта от начала до конца, чтобы извлечь коммерческую выгоду. Ключевое, что обязан усвоить продавец SPARK: девелопер — не строитель. Чаще всего он вообще не строит сам, а нанимает подрядчиков. Он владеет проектом, несёт риски и принимает решения. Значит, ему важны не «красивые картинки», а то, как визуал помогает быстрее и дороже продать проект и вернуть вложенные деньги.\n\nКак применять: с первых секунд говорите с девелопером на языке его результата — продажи, скорость запуска, возврат инвестиций, — а не на языке рендеров и полигонов. Тогда вы для него не «ещё один подрядчик по картинкам», а партнёр по деньгам.",
        scripts: ["«Вы же на проекте отвечаете и за продажи, а не только за стройку? Тогда покажу, как визуал напрямую влияет на скорость, с которой к вам приходят деньги.»"],
        quiz: [
          { q: "Девелопер — это прежде всего:", options: ["строительная бригада", "стратег, который владеет проектом и отвечает за прибыль", "брокер по продаже квартир"], correct: 1, why: "Девелопер владеет проектом и его коммерческим результатом — чаще даже не строит сам. Говорите с ним на языке проекта и денег." },
          { q: "Почему девелоперу важен визуал?", options: ["ради красоты", "он ускоряет и удорожает продажи проекта", "это требование закона"], correct: 1, why: "Визуал = инструмент продаж и возврата инвестиций. Продавайте эффект на деньги, а не эстетику." },
          { q: "На каком языке правильно говорить с девелопером?", options: ["про полигоны и рендеры", "про его результат: продажи, сроки, возврат инвестиций", "про погоду"], correct: 1, why: "Так вы становитесь партнёром по деньгам, а не очередным подрядчиком по картинкам." },
        ],
      },
      {
        id: "l2", title: "Пять зон ответственности девелопера", src: "Лекция 1",
        body: "Девелопер ведёт весь жизненный цикл проекта, и у него пять больших зон ответственности.\n\n1) Приобретение земли и анализ целесообразности — анализирует локации и рынок, оценивает финансовую жизнеспособность, решает, какой тип недвижимости строить. 2) Планирование и дизайн — работает с архитекторами, дизайнерами, инженерами, определяет планировки, эстетику и техтребования. 3) Финансирование и управление инвестициями — привлекает деньги (банки, инвесторы, собственный капитал), управляет бюджетом и прибыльностью. 4) Надзор за стройкой — нанимает и контролирует подрядчиков, следит за сроками, бюджетом и качеством. 5) Маркетинг и продажи — координирует продажи под локальный или зарубежный рынок.\n\nКак применять: зная эти зоны, вы понимаете, где у девелопера болит именно сейчас. На этапах планирования/дизайна (2) и маркетинга/продаж (5) он максимально нуждается в визуале — там ваш заход.",
        scripts: ["«На каком этапе проект — концепт, финансирование или уже выходите в продажи? От этого зависит, какой визуал даст вам максимум эффекта прямо сейчас.»"],
        quiz: [
