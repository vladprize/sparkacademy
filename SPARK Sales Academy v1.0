        { q: "Внутренние продажи — фокус на:", options: ["лайфстайл, локацию, удобство", "Non-Dom статус", "только опт"], correct: 0, why: "Местным продают образ жизни." },
        { q: "Международные продажи:", options: ["проще", "сложнее, но денег больше", "невозможны"], correct: 1, why: "Удалённый инвестор, ВНЖ/Non-Dom, выше чек." },
        { q: "Что важно зарубежному инвестору?", options: ["визуал и тур для удалённой покупки", "личный визит", "ничего"], correct: 0, why: "Он покупает по картинке и туру." },
        { q: "От сегмента зависит:", options: ["всё: цена, философия, маркетинг, бюджет", "ничего", "только цвет стен"], correct: 0, why: "Сегмент — базовый параметр проекта." },
        { q: "Комфорт — это:", options: ["вилла за 5 млн €", "доступное жильё для среднего класса и семей", "пентхаус 250 м²"], correct: 1, why: "Масс-маркет цена/качество." },
        { q: "Лакшери ЦА:", options: ["студенты", "очень богатые, владельцы бизнеса, часто для себя", "арендаторы"], correct: 1, why: "Эксклюзив для очень состоятельных." },
